rules_version = '2';

// ============================================================
// Firestore rules — CANCHAZO
// ESTADO ACTUAL: modo de prueba (open) para desarrollo rápido.
// EXPIRA: 2026-09-05. Después de esa fecha TODO queda denegado.
// TODO(hardening): reemplazar por reglas por colección
// (lectura pública para courts/reviews, escrituras autenticadas,
// dueño = users/{uid}.role == 'owner', etc.)
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 9, 5);
    }
  }
}
